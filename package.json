{
  "name": "eval-hub",
  "version": "0.26.10",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate",
    "prepare": "biome migrate --write",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/backend": "^3.16.13",
    "@clerk/nextjs": "^7.8.3",
